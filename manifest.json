{
  "manifest_version": 3,
  "name": "Moodle Annotate PDF Pen Support",
  "version": "1.1.2",

  "description": "Adds pen support to the Moodle annotate pdf plugin and removes \"Draft annotations saved\"-message.",
  "homepage_url": "https://github.com/MoritzHanke/Moodle-Annotate-PDF-Pen-Support",

  "icons": {
    "48": "icons/icon-48.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "moodle_annotate_pdf_pen@m0litz.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["*://*/mod/assign/view.php?*action=grader*"],
      "js": ["pen.js"]
    }
  ]
}
